# ==============================================================
# Apryde AI HRMS - Environment Configuration
# ==============================================================

# Project
PROJECT_NAME="Apryde AI HRMS"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-development-jwt-key-change-in-production-please-apryde"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL + pgvector)
POSTGRES_USER=hrms_user
POSTGRES_PASSWORD=hrms_secure_password
POSTGRES_DB=hrms_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=5433
DATABASE_URL=postgresql+asyncpg://hrms_user:hrms_secure_password@postgres:5432/hrms_db
SYNC_DATABASE_URL=postgresql://hrms_user:hrms_secure_password@postgres:5432/hrms_db

# Redis & Task Queue
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_EXTERNAL_PORT=6380
REDIS_URL=redis://redis:6379/0

# LLM Configuration (Dual Provider: Google Gemini & Ollama)
DEFAULT_LLM_PROVIDER=gemini
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-2.5-flash

# Local Ollama Settings (Optional containerized or host)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001","http://localhost:8000","http://localhost:8001","http://127.0.0.1:8000","http://127.0.0.1:8001","http://frontend:3000","http://frontend:3001"]

# Frontend & Backend Ports
NEXT_PUBLIC_API_URL=http://localhost:8001
FRONTEND_PORT=3001
BACKEND_PORT=8001
